NODE_ENV=development
PORT=3000
# Optional: docs default to enabled outside production. Set true to enable in production.
# ENABLE_API_DOCS=false

# Copy the exact URLs from your Supabase project's Connect dialog.
# URL-encode special characters in the password; do not include square brackets.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_URL_ENCODED_PASSWORD@YOUR_POOLER_HOST:5432/postgres"

# Transactional mail: uncomment and configure all SMTP fields to enable delivery.
FRONTEND_URL=http://localhost:3001
SMTP_PORT=587
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=sender@example.com
# SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
# SMTP_FROM=sender@example.com
# Use an App Password for Gmail, never your normal Gmail password.

