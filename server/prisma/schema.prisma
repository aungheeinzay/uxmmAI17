generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SME
  OPERATOR
  RIDER
}

// Profiles are created atomically with local accounts.
model Profile {
  id        String   @id @db.Uuid
  account   Account?
  fullName  String?  @map("full_name") @db.VarChar(120)
  phone     String?  @db.VarChar(32)
  role      Role     @default(SME)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  orders    ParcelOrder[]
  operatorOrders ParcelOrder[] @relation("OrderOperator")
  statusEvents OrderStatusEvent[]

  @@map("profiles")
}

model Account {
  id String @id @default(uuid()) @db.Uuid
  email String @unique @db.VarChar(254)
  passwordHash String @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  profile Profile @relation(fields: [id], references: [id], onDelete: Cascade)
  sessions AuthSession[]
  verificationToken EmailVerificationToken?
  passwordResetToken PasswordResetToken?
  riderInvitations RiderInvitation[]
  @@map("accounts")
}

model RiderInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  email       String    @unique @db.VarChar(254)
  fullName    String?   @map("full_name") @db.VarChar(120)
  tokenHash   String    @unique @map("token_hash")
  invitedById String    @map("invited_by_id") @db.Uuid
  invitedBy   Account   @relation(fields: [invitedById], references: [id], onDelete: Restrict)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([invitedById])
  @@index([expiresAt])
  @@map("rider_invitations")
}

model EmailVerificationToken {
  id String @id @default(uuid()) @db.Uuid
  accountId String @unique @map("account_id") @db.Uuid
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash String @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id String @id @default(uuid()) @db.Uuid
  accountId String @unique @map("account_id") @db.Uuid
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash String @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model AuthSession {
  id String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accessHash String @unique @map("access_hash")
  refreshHash String @unique @map("refresh_hash")
  accessExpiresAt DateTime @map("access_expires_at") @db.Timestamptz(3)
  refreshExpiresAt DateTime @map("refresh_expires_at") @db.Timestamptz(3)
  @@index([accountId])
  @@map("auth_sessions")
}

enum OrderStatus {
  CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
}

// Parcel weight is stored in kilograms (parcel_weight_kg). COD is MMK and is not a delivery fee.
// No delivery-fee column: pricing rules are not implemented. Access is through Express/Prisma only.
model ParcelOrder {
  id                    String          @id @default(uuid()) @db.Uuid
  orderCode             String          @unique @map("order_code") @db.VarChar(32)
  qrIdentifier          String          @unique @map("qr_identifier") @db.VarChar(64)
  ownerId               String          @map("owner_id") @db.Uuid
  owner                 Profile         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  operatorId            String?         @map("operator_id") @db.Uuid
  operator              Profile?        @relation("OrderOperator", fields: [operatorId], references: [id], onDelete: Restrict)
  recipientName         String          @map("recipient_name") @db.VarChar(120)
  phoneNumber           String          @map("phone_number") @db.VarChar(32)
  township              String          @db.VarChar(120)
  deliveryAddress       String          @map("delivery_address") @db.VarChar(500)
  parcelWeightKg        Decimal         @map("parcel_weight_kg") @db.Decimal(8, 3)
  codAmount             Decimal         @map("cod_amount") @db.Decimal(12, 2)
  currency              String          @default("MMK") @db.VarChar(3)
  senderName            String          @map("sender_name") @db.VarChar(120)
  deliveryInstructions  String?         @map("delivery_instructions") @db.VarChar(1000)
  status                OrderStatus     @default(CREATED)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  statusEvents          OrderStatusEvent[]

  @@index([ownerId])
  @@index([operatorId])
  @@map("orders")
}

// Append-only record of parcel status changes. The actor is always the
// authenticated user from the server session, never a client-supplied id.
model OrderStatusEvent {
  id             String      @id @default(uuid()) @db.Uuid
  orderId        String      @map("order_id") @db.Uuid
  order          ParcelOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorId        String      @map("actor_id") @db.Uuid
  actor          Profile     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  previousStatus OrderStatus @map("previous_status")
  status         OrderStatus
  note           String?     @db.VarChar(1000)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([orderId, createdAt])
  @@map("order_status_events")
}
