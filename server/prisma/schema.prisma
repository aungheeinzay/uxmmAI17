generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SME
  OPERATOR
  RIDER
}

// Profiles are created atomically with local accounts.
model Profile {
  id        String   @id @db.Uuid
  account   Account?
  fullName  String?  @map("full_name") @db.VarChar(120)
  phone     String?  @db.VarChar(32)
  role      Role     @default(SME)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("profiles")
}

model Account {
  id String @id @default(uuid()) @db.Uuid
  email String @unique @db.VarChar(254)
  passwordHash String @map("password_hash")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  profile Profile @relation(fields: [id], references: [id], onDelete: Cascade)
  sessions AuthSession[]
  verificationToken EmailVerificationToken?
  passwordResetToken PasswordResetToken?
  riderInvitations RiderInvitation[]
  @@map("accounts")
}

model RiderInvitation {
  id          String    @id @default(uuid()) @db.Uuid
  email       String    @unique @db.VarChar(254)
  fullName    String?   @map("full_name") @db.VarChar(120)
  tokenHash   String    @unique @map("token_hash")
  invitedById String    @map("invited_by_id") @db.Uuid
  invitedBy   Account   @relation(fields: [invitedById], references: [id], onDelete: Restrict)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([invitedById])
  @@index([expiresAt])
  @@map("rider_invitations")
}

model EmailVerificationToken {
  id String @id @default(uuid()) @db.Uuid
  accountId String @unique @map("account_id") @db.Uuid
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash String @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id String @id @default(uuid()) @db.Uuid
  accountId String @unique @map("account_id") @db.Uuid
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash String @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model AuthSession {
  id String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accessHash String @unique @map("access_hash")
  refreshHash String @unique @map("refresh_hash")
  accessExpiresAt DateTime @map("access_expires_at") @db.Timestamptz(3)
  refreshExpiresAt DateTime @map("refresh_expires_at") @db.Timestamptz(3)
  @@index([accountId])
  @@map("auth_sessions")
}
