{
  "name": "server",
  "version": "1.0.0",
  "description": "Express API server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "seed:dev": "tsx src/seed/run.ts",
    "seed:providers": "tsx src/seed/providers.run.ts",
    "operator:assign-provider": "tsx src/seed/operator-provider.run.ts",
    "rider:assign-provider": "tsx src/seed/rider-provider.run.ts",
    "test": "npm run build && node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/swagger-ui-express": "^4.1.8",
    "prisma": "^7.10.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
